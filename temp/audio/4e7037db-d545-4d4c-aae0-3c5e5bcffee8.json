  "scenes": [
    {
      "index": 0,
      "text": "¿Te sientes estancado?",
      "visual": "pantalla negra, música sube",
      "tone": "entusiasta",
      "startWord": 0,
      "endWord": 2,
      "startTime": 0,
      "endTime": 3725
    },
    {
      "index": 1,
      "text": "No estás solo.",
      "visual": "persona mirando al espejo",
      "tone": "neutral",
      "startWord": 3,
      "endWord": 5,
      "startTime": 3725,
      "endTime": 7451
    },
    {
      "index": 2,
      "text": "Hace un año, dudaba de mis sueños.",
      "visual": "flashback a un escritorio desordenado",
      "tone": "neutral",
      "startWord": 6,
      "endWord": 12,
      "startTime": 7451,
      "endTime": 16144
    },
    {
      "index": 3,
      "text": "Cada mañana, el despertador sonaba, pero el ánimo no.",
      "visual": "reloj marcando 6:00, cara cansada",
      "tone": "neutral",
      "startWord": 13,
      "endWord": 21,
      "startTime": 16144,
      "endTime": 27320
    },
    {
      "index": 4,
      "text": "Decidí cambiar una cosa: dar solo cinco minutos a mi proyecto.",
      "visual": "mano escribiendo en una libreta",
      "tone": "neutral",
      "startWord": 22,
      "endWord": 32,
      "startTime": 27320,
      "endTime": 40980
    },
    {
      "index": 5,
      "text": "Ese pequeño paso encendió una chispa.",
      "visual": "chispa animada sobre la libreta",
      "tone": "neutral",
      "startWord": 33,
      "endWord": 38,
      "startTime": 40980,
      "endTime": 48431
    },
    {
      "index": 6,
      "text": "En una semana, completé mi primer módulo.",
      "visual": "pantalla con barra de progreso al 100%",
      "tone": "neutral",
      "startWord": 39,
      "endWord": 45,
      "startTime": 48431,
      "endTime": 57124
    },
    {
      "index": 7,
      "text": "Cada victoria, por mínima, alimentó mi energía.",
      "visual": "gráfica ascendente",
      "tone": "neutral",
      "startWord": 46,
      "endWord": 52,
      "startTime": 57124,
      "endTime": 65817
    },
    {
      "index": 8,
      "text": "La constancia se volvió mi aliada.",
      "visual": "calendario con días marcados",
      "tone": "neutral",
      "startWord": 53,
      "endWord": 58,
      "startTime": 65817,
      "endTime": 73267
    },
    {
      "index": 9,
      "text": "¡Hoy es el día!",
      "visual": "texto brillante en pantalla",
      "tone": "entusiasta",
      "startWord": 59,
      "endWord": 62,
      "startTime": 73267,
      "endTime": 78235
    },
    {
      "index": 10,
      "text": "Transforma la duda en acción.",
      "visual": "silueta saltando sobre una brecha",
      "tone": "entusiasta",
      "startWord": 63,
      "endWord": 67,
      "startTime": 78235,
      "endTime": 84444
    },
    {
      "index": 11,
      "text": "Visualiza tu meta, siente el impulso, avanza sin miedo.",
      "visual": "persona corriendo hacia una meta luminosa",
      "tone": "entusiasta",
      "startWord": 68,
      "endWord": 76,
      "startTime": 84444,
      "endTime": 95620
    },
    {
      "index": 12,
      "text": "Ahora, tú también puedes.",
      "visual": "mirada directa a la cámara",
      "tone": "entusiasta",
      "startWord": 77,
      "endWord": 80,
      "startTime": 95620,
      "endTime": 100588
    },
    {
      "index": 13,
      "text": "Cuéntanos en los comentarios una meta para los próximos siete días.",
      "visual": "caja de comentarios resaltada",
      "tone": "entusiasta",
      "startWord": 81,
      "endWord": 91,
      "startTime": 100588,
      "endTime": 114248
    },
    {
      "index": 14,
      "text": "Suscríbete y recibe cada lunes el reto semanal.",
      "visual": "icono de suscripción pulsando",
      "tone": "entusiasta",
      "startWord": 92,
      "endWord": 99,
      "startTime": 114248,
      "endTime": 124182
    },
    {
      "index": 15,
      "text": "¡Vamos a lograrlo juntos!",
      "visual": "grupo celebrando al atardecer",
      "tone": "entusiasta",
      "startWord": 100,
      "endWord": 103,
      "startTime": 124182,
      "endTime": 129149
