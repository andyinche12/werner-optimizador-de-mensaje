# werner Audio Factory - Variables de Entorno
# Copia este archivo a .env y completa los valores

# ============================================================
# OBLIGATORIA
# ============================================================
GROQ_API_KEY=tu_groq_api_key_aqui

# ============================================================
# SERVIDOR (defaults funcionan para desarrollo)
# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ============================================================
# ALMACENAMIENTO TEMPORAL
# ============================================================
TEMP_DIR=./temp
MAX_SCRIPT_LENGTH=50000
MAX_TTS_CHARS=5000
AUDIO_CLEANUP_HOURS=24

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info

# ============================================================
# MONETIZACIÓN - PLACEHOLDERS (se reemplazan en descripciones)
# ============================================================
# Cambia estos por tus links reales de afiliados/referidos
AFFILIATE_BROKER={{BROKER_LINK}}
AFFILIATE_TEMPLATE={{TEMPLATE_LINK}}
AFFILIATE_BOOK={{BOOK_LINK}}

# Info de tu canal/marca
CHANNEL_NAME=Mi Canal
NICHE=general

# ============================================================
# PRODUCCIÓN (Render/Vercel configurarán automáticamente)
# ============================================================
# NODE_ENV=production
# PORT=10000
# FRONTEND_URL=https://tu-proyecto.vercel.app