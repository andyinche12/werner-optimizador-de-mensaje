  "scenes": [
    {
      "index": 0,
      "text": "¿Qué harías si supieras que solo tienes 60 segundos para cambiar tu vida?",
      "visual": "reloj marcando 60 segundos",
      "tone": "entusiasta",
      "startWord": 0,
      "endWord": 12,
      "startTime": 0,
      "endTime": 18098
    },
    {
      "index": 1,
      "text": "Conozco a Ana, una estudiante que perdió su beca en un día lluvioso.",
      "visual": "Ana recibiendo carta de rechazo",
      "tone": "neutral",
      "startWord": 13,
      "endWord": 25,
      "startTime": 18098,
      "endTime": 36195
    },
    {
      "index": 2,
      "text": "En lugar de rendirse, tomó su laptop, buscó una oportunidad y se inscribió a un concurso online.",
      "visual": "Ana encendiendo su laptop",
      "tone": "neutral",
      "startWord": 26,
      "endWord": 42,
      "startTime": 36195,
      "endTime": 59862
    },
    {
      "index": 3,
      "text": "En menos de una hora, ganó el primer puesto y recuperó su financiamiento.",
      "visual": "pantalla mostrando “¡Ganador!”",
      "tone": "neutral",
      "startWord": 43,
      "endWord": 55,
      "startTime": 59862,
      "endTime": 77959
    },
    {
      "index": 4,
      "text": "Ese instante fue su despertar…",
      "visual": "luz brillante alrededor de Ana",
      "tone": "neutral",
      "startWord": 56,
      "endWord": 60,
      "startTime": 77959,
      "endTime": 84920
    },
    {
      "index": 5,
      "text": "Sintió la energía del éxito recorriendo su cuerpo.",
      "visual": "energía visual, aura",
      "tone": "neutral",
      "startWord": 61,
      "endWord": 68,
      "startTime": 84920,
      "endTime": 96057
    },
    {
      "index": 6,
      "text": "Ahora tú puedes hacerlo.",
      "visual": "cámara enfocando al oyente",
      "tone": "neutral",
      "startWord": 69,
      "endWord": 72,
      "startTime": 96057,
      "endTime": 101625
    },
    {
      "index": 7,
      "text": "Decide tu meta para los próximos 60 segundos y actúa sin miedo.",
      "visual": "cronómetro marcando 60 segundos",
      "tone": "neutral",
      "startWord": 73,
      "endWord": 84,
      "startTime": 101625,
      "endTime": 118331
    },
    {
      "index": 8,
      "text": "Deja en los comentarios qué objetivo vas a conquistar y suscríbete para más retos diarios.",
      "visual": "caja de comentarios y botón suscribirse",
      "tone": "entusiasta",
      "startWord": 85,
      "endWord": 99,
      "startTime": 118331,
      "endTime": 139213
    },
    {
      "index": 9,
      "text": "¡Vamos, el tiempo es tu aliado!",
      "visual": "explosión de colores",
      "tone": "entusiasta",
      "startWord": 100,
      "endWord": 105,
      "startTime": 139213,
      "endTime": 147566
    }
  ]
